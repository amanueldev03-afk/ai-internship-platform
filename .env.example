# =============================================================================
# SmartIntern-ET — Environment Configuration Template (.env.example)
# =============================================================================

# Django Security & Core Settings
SECRET_KEY=supersecret-django-smartintern-et-key-change-in-production
DEBUG=True
ALLOWED_HOSTS=*
TIME_ZONE=Africa/Addis_Ababa

# Database Configuration (PostgreSQL 16 + pgvector)
POSTGRES_DB=smartintern_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgres://postgres:postgres@postgres:5432/smartintern_db

# Redis & Celery Task Broker
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/1
CELERY_TASK_ALWAYS_EAGER=False

# JWT Authentication
JWT_SECRET=supersecret

# SMS & Telegram Low-Bandwidth Notifications
TELEGRAM_BOT_TOKEN=
ETHIO_SMS_API_KEY=

# Frontend and URLs
FRONTEND_URL=http://localhost:5173
SITE_BASE_URL=http://localhost:8000

# File Storage (filesystem for local dev, s3 for production)
STORAGE_BACKEND=filesystem

# Optional S3 Storage Settings
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=us-east-1
AWS_S3_ENDPOINT_URL=
AWS_S3_CUSTOM_DOMAIN=

# Email Settings (for notifications and clearance updates)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=25
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@smartintern.edu.et

# Google OAuth (Optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FRONTEND_OAUTH_CALLBACK_URL=http://localhost:5173/auth/callback

# AI & Machine Learning Configuration
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
OPENAI_API_KEY=

# Ethiopian UIL Logistics & Per Diem Rates
DAILY_PER_DIEM_LOCAL_RATE=50.00
DAILY_PER_DIEM_OUTOFTOWN_RATE=350.00
