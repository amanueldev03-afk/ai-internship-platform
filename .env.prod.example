# =============================================================================
# AI Internship Platform — Production Environment Variables
# Copy to .env.prod or export into the deployment environment.
# =============================================================================

# --- Django Production Settings ---
DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_ENV=production
DEBUG=False
SECRET_KEY=generate-a-strong-random-secret-key-for-production
ALLOWED_HOSTS=localhost,127.0.0.1,backend,frontend,yourdomain.com
SITE_BASE_URL=https://yourdomain.com
FRONTEND_URL=https://yourdomain.com

# --- Security: CORS & CSRF ---
CORS_ALLOWED_ORIGINS=https://yourdomain.com,http://localhost
CSRF_TRUSTED_ORIGINS=https://yourdomain.com,http://localhost

# --- Port exposed to host ---
FRONTEND_PORT=80

# --- PostgreSQL Database ---
POSTGRES_DB=ai_internship
POSTGRES_USER=ai_user
POSTGRES_PASSWORD=replace_with_secure_password
# Internal Docker Compose connection URL:
# DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}

# --- Redis & Celery ---
REDIS_URL=redis://redis:6379/1
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CELERY_TASK_ALWAYS_EAGER=False

# --- Email Configuration (Production SMTP) ---
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=your-sendgrid-or-smtp-password
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@yourdomain.com
NOTIFICATION_HIGH_SCORE_THRESHOLD=80

# --- Google OAuth (Optional) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FRONTEND_OAUTH_CALLBACK_URL=https://yourdomain.com/auth/callback

# --- AI & Embeddings ---
OPENAI_API_KEY=

# --- File Storage (filesystem or s3) ---
STORAGE_BACKEND=filesystem
# If STORAGE_BACKEND=s3:
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=us-east-1
AWS_S3_ENDPOINT_URL=
AWS_S3_CUSTOM_DOMAIN=
AWS_QUERYSTRING_AUTH=True

# --- Database Backup & Disaster Recovery (Task 11.6) ---
# Backup-specific S3 bucket (can be same as AWS_STORAGE_BUCKET_NAME or separate)
BACKUP_S3_BUCKET_NAME=
# Backup storage prefix in S3 (separate from application files)
BACKUP_S3_PREFIX=backups/postgresql/
