# ===========================
# Django
# ===========================
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# ===========================
# Frontend URL (for email links)
# ===========================
FRONTEND_URL=http://localhost:5173

# ===========================
# PostgreSQL (Docker Compose local)
# ===========================
POSTGRES_DB=ai_internship
POSTGRES_USER=ai_user
POSTGRES_PASSWORD=ai_password

# Local Docker DATABASE_URL (default for development)
DATABASE_URL=postgresql://ai_user:ai_password@localhost:5432/ai_internship

# Neon / production URL (comment the local one above and uncomment this)
# DATABASE_URL=postgresql://username:password@host:port/database?sslmode=require

# ===========================
# Time Zone
# ===========================
TIME_ZONE=UTC

# ===========================
# Email Configuration
# ===========================
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=your-email@gmail.com

# ===========================
# Google OAuth (Optional)
# ===========================
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
# SPA route that receives JWT tokens after a successful Google sign-in.
# Must match what you registered in the Google Cloud Console for the
# local backend origin (http://localhost:8000/accounts/google/login/callback/)
FRONTEND_OAUTH_CALLBACK_URL=http://localhost:5173/auth/callback

# ===========================
# Celery / Redis
# ===========================
REDIS_URL=redis://localhost:6379/1
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Phase 3 Task 3.5 — run Celery tasks synchronously (no broker) in dev/tests.
# Set True to exercise the resume-parsing pipeline without a running worker.
CELERY_TASK_ALWAYS_EAGER=False

# ===========================
# OpenAI
# ===========================
OPENAI_API_KEY=your_api_key_here

# ===========================
# File Storage (Section 7.7.2)
# ===========================
# filesystem (default, local dev) or s3 (S3-compatible object storage)
STORAGE_BACKEND=filesystem

# --- S3 / S3-compatible storage (used when STORAGE_BACKEND=s3) ---
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_STORAGE_BUCKET_NAME=your-bucket-name
AWS_S3_REGION_NAME=us-east-1
# Optional: custom endpoint (MinIO / DigitalOcean Spaces / Wasabi), leave empty for AWS
AWS_S3_ENDPOINT_URL=
# Optional: public CDN/domain; when set, resume URLs are public, otherwise signed
AWS_S3_CUSTOM_DOMAIN=
# Signed URLs for private resumes unless AWS_S3_CUSTOM_DOMAIN is set
AWS_QUERYSTRING_AUTH=True
